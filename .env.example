# Copia este archivo a `.env` y rellena los valores reales.
# `.env` está en .gitignore y NUNCA se versiona.
#
# Las variables las lee modelo.py vía os.environ.
# FORUM_DB_PASSWORD es obligatoria: si falta, la app falla al arrancar
# (en lugar de conectar con un valor por defecto silencioso).

# Clave estable para sesiones y tokens CSRF.
# Genera una: python -c "import secrets; print(secrets.token_hex(32))"
FORUM_SECRET_KEY=change-me-to-a-long-random-value

# Modo debug: 1 = activado. NUNCA 1 en producción.
FORUM_DEBUG=0

FORUM_DB_HOST=localhost
FORUM_DB_NAME=forum
FORUM_DB_USER=forum
FORUM_DB_PASSWORD=change-me

# SMTP para correos salientes (recuperación/notificaciones)
FORUM_SMTP_HOST=smtp.gmail.com
FORUM_SMTP_PORT=587
FORUM_SMTP_USER=your-address@example.com
FORUM_SMTP_PASSWORD=your-app-password
